# Shared
NODE_ENV=development
LOG_LEVEL=info
AWS_REGION=us-east-1

# DynamoDB (local endpoint optional; omit in AWS to use default)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_USERS_TABLE=users
DYNAMODB_ORDERS_TABLE=orders

# Redis Cluster (comma-separated host:port seed nodes)
REDIS_NODES=localhost:7000
REDIS_TLS=false
CACHE_TTL_SECONDS=60

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=federated-service

# Service ports
USERS_PORT=4001
ORDERS_PORT=4002
